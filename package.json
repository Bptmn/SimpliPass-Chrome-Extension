{
  "name": "simplipass-chrome-extension",
  "version": "1.0.0",
  "description": "SimpliPass Chrome Extension",
  "main": "background/background.js",
  "scripts": {
    "validate:env": "node scripts/validate-env.js",
    "dev": "vite --config configs/build/vite/vite.config.ts",
    "dev:web": "vite --config configs/build/vite/vite.config.web.ts",
    "build": "vite build --config configs/build/vite/vite.background.config.ts && vite build --config configs/build/vite/vite.content.config.ts && vite build --config configs/build/vite/vite.config.ts && cp dist/packages/extension/popup/popup.html dist/ && sed -i '' 's|\"../../../assets/|\"assets/|g' dist/popup.html",
    "dev:extension": "vite --config configs/build/vite/vite.config.ts",
    "build:extension": "vite build --config configs/build/vite/vite.config.ts && cp dist/packages/extension/popup/popup.html dist/popup.html",
    "build:web": "vite build --config configs/build/vite/vite.config.web.ts",
    "preview:web": "vite preview --config configs/build/vite/vite.config.web.ts",
    "type-check": "tsc --noEmit",
    "type-check:extension": "tsc --noEmit -p configs/types/tsconfig.extension.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --config configs/test/jest.config.js",
    "test:watch": "jest --watch --config configs/test/jest.config.js",
    "test:coverage": "jest --coverage --config configs/test/jest.config.js",
    "emulator": "firebase emulators:start --only firestore --project test-project",
    "test:firestore": "start-server-and-test emulator http-get://localhost:8080 test:firestore-jest",
    "test:firestore-jest": "jest packages/common/core/libraries/database/__tests__/firestore.integration.test.ts",
    "lint:extension": "eslint packages/extension --ext .ts,.tsx",
    "lint:extension:fix": "eslint packages/extension --ext .ts,.tsx --fix",
    "test:extension": "jest --config configs/test/jest.config.js packages/extension packages/common/core packages/common/utils packages/common/hooks",
    "test:all": "npm run test:extension"
  },
  "dependencies": {
    "@stablelib/chacha20poly1305": "^2.0.1",
    "@stablelib/random": "^2.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "amazon-cognito-identity-js": "^6.0.0",
    "aws-amplify": "^6.15.1",
    "firebase": "^10.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.6.2",
    "react-window": "^1.8.11",
    "zustand": "^5.0.6",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.27.1",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@crxjs/vite-plugin": "^2.0.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/chrome": "^0.0.326",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react-window": "^1.8.8",
    "@types/zxcvbn": "^4.4.5",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitejs/plugin-legacy": "^7.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "css-loader": "^7.1.2",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fake-indexeddb": "^6.0.1",
    "firebase-tools": "^14.11.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react-test-renderer": "^18.2.0",
    "start-server-and-test": "^2.0.13",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^7.0.2",
    "vite-plugin-static-copy": "^3.1.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
