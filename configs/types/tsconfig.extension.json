{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "../../",
    "paths": {
      "@common/*": ["packages/common/*"],
      "@extension/*": ["packages/extension/*"]
    }
  },
  "include": [
    "../../packages/extension/**/*",
    "../../packages/common/types/**/*",
    "../../packages/common/utils/**/*"
  ],
  "exclude": [
    "../../packages/common/hooks/**",
    "../../packages/common/**/__tests__/**",
    "../../packages/extension/__tests__/**"
  ]
}
