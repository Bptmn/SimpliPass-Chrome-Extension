# SimpliPass Chrome Extension - Environment Variables Example
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================
# Firebase Configuration (Required)
# ============================================
# Get these values from your Firebase project settings:
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# ============================================
# AWS Cognito Configuration (Required)
# ============================================
# Get these values from your AWS Cognito User Pool settings:
# https://console.aws.amazon.com/cognito/v2/idp/user-pools
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_CLIENT_ID=your-client-id
VITE_COGNITO_REGION=us-east-1

# ============================================
# Test User Credentials (Optional - for E2E tests)
# ============================================
# These are used by Playwright E2E tests
# Create test users in your Firebase/Cognito project
TEST_USER_EMAIL=test@simplipass.com
TEST_USER_PASSWORD=TestPass123!

# MFA test user (if testing MFA flows)
TEST_MFA_USER_EMAIL=mfa@simplipass.com
TEST_MFA_USER_PASSWORD=MfaPass123!
TEST_MFA_CODE=123456

# Admin test user (if testing admin features)
TEST_ADMIN_EMAIL=admin@simplipass.com
TEST_ADMIN_PASSWORD=AdminPass123!

# ============================================
# Test Configuration (Optional)
# ============================================
# Run tests in headless mode (true/false)
HEADLESS=false

# Slow down test execution for debugging (milliseconds)
# Set to 0 to run at normal speed
SLOWMO=0

# ============================================
# Development Mode (Optional)
# ============================================
# Enable web mode for development (true/false)
# When true, runs as a web app instead of Chrome extension
WEB_MODE=false

# ============================================
# Node Environment (Auto-set by npm scripts)
# ============================================
# NODE_ENV is automatically set by npm scripts
# development: npm run dev
# production: npm run build
# test: npm run test
